# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# ==============================================================================

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Get these from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key - safe to expose to the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key - KEEP SECRET! Server-side only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==============================================================================
# DATABASE URLS (for Drizzle ORM)
# ==============================================================================
# Get your database connection string from Supabase:
# https://supabase.com/dashboard/project/_/settings/database
# Use the "Connection Pooling" URL with port 6543

# Replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ==============================================================================
# ANTHROPIC API CONFIGURATION
# ==============================================================================
# Get your API key from: https://console.anthropic.com/

NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ==============================================================================
# RESEND EMAIL CONFIGURATION
# ==============================================================================
# Get your API key from: https://resend.com/api-keys

RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=feedback@yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Admin email for system notifications
ADMIN_EMAIL=admin@yourdomain.com

# ==============================================================================
# AI INTRANET CONFIGURATION
# ==============================================================================
# Get these from your AI Intranet application settings

APP_ID=your-app-id-here
APP_API_KEY=your-app-api-key-here

# ==============================================================================
# ENVIRONMENT CONTROL
# ==============================================================================
# Set to 'true' for local testing with local AI Intranet
# Set to 'false' for production with cloud AI Intranet
LOCAL_TESTING_MODE=true
NODE_ENV=development

# ==============================================================================
# AI INTRANET URLs
# ==============================================================================
# Production AI Intranet URLs (cloud)
AI_INTRANET_URL_PROD=https://aiintranet.yourdomain.com
NEXT_PUBLIC_AI_INTRANET_URL_PROD=https://aiintranet.yourdomain.com

# Local AI Intranet Server URLs (development)
# Note: AI Intranet typically runs on port 3001
AI_INTRANET_URL_LOCAL=http://localhost:3001
NEXT_PUBLIC_AI_INTRANET_URL_LOCAL=http://localhost:3001

# Active configuration (will be set dynamically based on LOCAL_TESTING_MODE)
# For local development, use local URLs
AI_INTRANET_URL=http://localhost:3001
NEXT_PUBLIC_AI_INTRANET_URL=http://localhost:3001
NEXT_PUBLIC_APP_ID=your-app-id-here

# ==============================================================================
# APPLICATION INFO
# ==============================================================================
APP_NAME="Talent Management Platform"

# ==============================================================================
# AUTHENTICATION CONFIGURATION
# ==============================================================================
# Set DISABLE_AUTH=true to bypass authentication (for local development)
# Set DISABLE_AUTH=false to require Auth0 (for production)
DISABLE_AUTH=true
NEXT_PUBLIC_DISABLE_AUTH=true

# ==============================================================================
# AUTH0 CONFIGURATION (Optional - only needed if using Auth0)
# ==============================================================================
# Get these from your Auth0 dashboard: https://manage.auth0.com/

# Generate with: openssl rand -hex 32
AUTH0_SECRET=use-openssl-rand-hex-32-to-generate-this

# Your application URL
AUTH0_BASE_URL=http://localhost:3004

# Your Auth0 domain
AUTH0_ISSUER_BASE_URL=https://your-domain.auth0.com

# Your Auth0 application credentials
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# ==============================================================================
# SETUP INSTRUCTIONS
# ==============================================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in all the values above with your actual credentials
# 3. Never commit .env.local to version control
# 4. Run: npm run verify-db to test your Supabase connection
# 5. Run: npm run dev to start the development server
#
# For MCP configuration:
# - Run: npm run setup-mcp to configure the Supabase MCP server
# - This enables Claude Code to access your database schema
# ==============================================================================
