{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/send-survey-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/sync-users",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/process-report-generation-queue",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://teams.microsoft.com https://*.teams.microsoft.com https://*.skype.com https://*.teams.microsoft.us https://*.gov.teams.microsoft.us"
        }
      ]
    }
  ]
}
