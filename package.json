{
  "name": "talent-management-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash ./run-dev.sh",
    "dev:open": "bash ./run-dev.sh --turbo",
    "dev:local": "LOCAL_TESTING_MODE=true bash ./run-dev.sh",
    "dev:prod": "LOCAL_TESTING_MODE=false bash ./run-dev.sh",
    "dev:360": "PORT=${PORT:-3005} bash ./run-dev.sh",
    "dev:employee": "PORT=${PORT:-3006} bash ./run-dev.sh",
    "dev:performance": "PORT=${PORT:-3007} bash ./run-dev.sh",
    "build": "next build",
    "start": "next start -p 3004",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest __tests__/integration --ci --maxWorkers=2",
    "test:security": "./scripts/pre-commit-checks.sh",
    "test:all": "npm run lint && npm run test:coverage && npm run test:integration && npm run test:security",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:desktop": "playwright test --project=chromium --project=firefox --project=webkit",
    "e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari --project=tablet",
    "e2e:a11y": "playwright test e2e/accessibility.spec.ts",
    "e2e:visual": "playwright test e2e/visual-regression.spec.ts",
    "e2e:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "validate:html": "node scripts/validate-html.js",
    "prepare": "husky install",
    "setup-mcp": "node scripts/setup-mcp.js",
    "verify-db": "node scripts/verify-supabase.js",
    "mcp": "node scripts/smart-supabase-mcp.js",
    "generate-test-360": "npx ts-node scripts/generate-test-360-data.ts",
    "ts-prune": "ts-prune",
    "knip": "knip"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@microsoft/teams-js": "^2.55.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.109.0",
    "html2canvas": "^1.4.1",
    "jsonrepair": "^3.15.0",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "next": "14.2.33",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.25.0",
    "uuid": "^13.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "axe-core": "^4.13.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "html-validate": "^10.17.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{js,jsx}": [
      "eslint --fix --max-warnings=0"
    ]
  }
}
